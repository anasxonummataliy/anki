# Telegram Serverless CLI Token (BotFather -> Serverless -> CLI Access -> Access token)
TGCLOUD_TOKEN=app12345:your_secret_access_token_here

# Bot Owner / Admin Telegram User ID (Sizning shaxsiy Telegram ID raqamingiz, masalan @userinfobot orqali olish mumkin)
# Bir nechta bo'lsa vergul bilan ajrating: 12345678,98765432
ADMIN_TELEGRAM_ID=123456789
